{
  "duration": 60,
  "loop": true,
  "emitters": [
    {
      "name": "motes",
      "duration": 60,
      "template": {
        "render": { "type": "sprite", "sprite": "eden_particles:glow", "blend": "additive", "emissive": true },
        "lifetime": [60, 80],
        "size": { "keys": [[0, 0.0], [0.1, 0.18], [1, 0.12]] },
        "alpha": 0.7,
        "color": [{ "t": 0, "color": "#7FFFD4" }, { "t": 1, "color": "#2FA8FF" }],
        "physics": {
          "drag": 0.9,
          "forces": [
            { "type": "attractor", "point": [0, 1, 0], "strength": 0.035, "absorb": 0.35 },
            { "type": "vortex", "point": [0, 1, 0], "strength": 0.008, "falloff": "linear", "radius": 4 }
          ]
        },
        "on_death": { "effect": "eden_particles:examples/absorb_spark", "chance": 0.5 }
      },
      "shape": { "type": "sphere", "radius": 3, "surface": true },
      "spawn": { "rate": 3, "jitter": true },
      "offset": [0, 1, 0]
    },
    {
      "name": "core",
      "duration": 60,
      "template": {
        "render": { "type": "sprite", "sprite": "eden_particles:glow", "blend": "additive", "emissive": true },
        "lifetime": 8,
        "size": [[0, 0.3], [1, 0.45]],
        "alpha": [[0, 0.4], [1, 0.0]],
        "color": "#9FF5FF"
      },
      "spawn": { "rate": 1 },
      "offset": [0, 1, 0]
    }
  ]
}
